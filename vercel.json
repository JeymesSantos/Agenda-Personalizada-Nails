{
  "ignoreCommand": "node -e \"process.exit(['main','staging'].includes(process.env.VERCEL_GIT_COMMIT_REF) ? 1 : 0)\"",
  "buildCommand": "pnpm run build:vercel",
  "crons": [{ "path": "/api/cron/reminders", "schedule": "0 9 * * *" }],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "staging": true,
      "*": false
    }
  }
}
