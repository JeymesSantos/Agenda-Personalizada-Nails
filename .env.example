# Banco de dados (docker compose up -d sobe um Postgres local com estes dados)
DATABASE_URL="postgresql://minhaagenda:minhaagenda@localhost:5432/minhaagenda?schema=public"

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Arquivos enviados: sem token grava em public/uploads (dev); com token usa o Vercel Blob (produção)
BLOB_READ_WRITE_TOKEN=""

# Lembretes por e-mail (Resend). Sem chave, os e-mails só aparecem no log do servidor.
RESEND_API_KEY=""
EMAIL_FROM="MinhaAgenda <onboarding@resend.dev>"
# Protege GET /api/cron/reminders (a Vercel envia este valor no header Authorization). Vazio em dev.
CRON_SECRET=""

# Fuso horário do estúdio
TZ="America/Sao_Paulo"

# Figma (só para scripts de extração de design; opcional)
FIGMA_TOKEN=""
FIGMA_FILE_KEY=""
